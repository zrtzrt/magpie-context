{
  "name": "magpie-context",
  "version": "1.2.0",
  "description": "Magpie 上下文透视插件 — 跨 Agent 会话内容与上下文增长可视化、Token 构成与压缩事件追踪",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/**/*.test.mjs",
    "sync": "node bin/magpie-context.mjs sync",
    "watch": "node bin/magpie-context.mjs watch",
    "doctor": "node bin/magpie-context.mjs doctor",
    "prepack": "node scripts/ensure-placeholder.mjs --pack",
    "postpack": "node scripts/restore-local.mjs"
  },
  "bin": {
    "magpie-context": "bin/magpie-context.mjs"
  },
  "files": [
    "bin/magpie-context.mjs",
    "bin/target.mjs",
    "daemon.mjs",
    "dsh-events.mjs",
    "dsh-fileops.mjs",
    "page/index.html",
    "page/style.css",
    "page/app.js",
    "page/icons.js",
    "page/icon.svg",
    "page/context-data.js",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "opencode",
    "context",
    "context-window",
    "token-growth",
    "observability",
    "ai-agents"
  ],
  "author": "zrtzrt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrtzrt/magpie-context.git"
  },
  "homepage": "https://github.com/zrtzrt/magpie-context#readme",
  "bugs": {
    "url": "https://github.com/zrtzrt/magpie-context/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "magpie": {
    "name": "上下文",
    "summary": {
      "zh": "跨 Agent 会话内容与上下文增长可视化 —— 实时看 System/User/Assistant/Tools Token 构成、压缩事件与单轮内容透视",
      "en": "Cross-agent context evolution & message inspector — token composition, compaction events and full turn payloads"
    },
    "page": {
      "title": "上下文",
      "titles": {
        "zh": "上下文",
        "zh-TW": "上下文",
        "en": "Context",
        "ja": "コンテキスト"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
